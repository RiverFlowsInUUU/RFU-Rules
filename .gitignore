# 上游源文件的临时下载目录 —— 由使用者/CI 按需取用，不入库。
# 取法与用途见 skill/SKILL.md「完整生成」节；CI 在每次运行时下载（见 .github/workflows/ci.yml）。
# ⚠️ 不入库是有意的：上游每周漂，把快照提交进来会让人误以为「仓库内的源就是权威」，
#    而本仓的定位是**格式转换镜像**（产物才是交付物），源的权威永远在上游。
jinx-rules/

# Python 字节码缓存（脚本以 python xxx.py 直接执行，无需提交编译产物）
__pycache__/
*.pyc

# 转换脚本的中间输出目录（重跑生成时的落脚点，不覆盖仓库固定名文件前都属临时）
out/
_regen/

# cn-adblock 构建器的源快照目录（可复现用，不入库；与 jinx-rules/ 同一思路）
test/_src/
